# Copy to .env and fill in your own key. Never commit the real .env.
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_PROVIDER=deepseek
RENDER_SCALE=2

# Optional limits
# MAX_UPLOAD_MB=60
# AI_MAX_STEPS=10
# AI_MAX_OPS=24

# Security (v0.1.2). Loopback hosts are always trusted. When serving through a
# reverse proxy such as `tailscale serve`, add the public hostname/origin so
# browser traffic is not rejected as cross-site:
# TRUSTED_HOSTS=macbookpro.example.ts.net
# TRUSTED_ORIGINS=https://macbookpro.example.ts.net:9443
# Cap (in MB) for JSON request bodies (apply/chat):
# MAX_JSON_BODY_MB=2
# Allow auto-apply to execute delete_textbox/clear ops without review:
# AUTO_APPLY_DESTRUCTIVE=0

# Resource limits (v0.1.3+)
# AI_CONCURRENCY=2
# RENDER_QUEUE_MAX=4
# RENDER_MAX_PAGES=500
# PARSE_MAX_SLIDES=500
# PARSE_MAX_SHAPES=5000
# PARSE_MAX_GROUP_DEPTH=20
# MAX_VERSIONS=50
